---
---

<!-- Ambient Gradient Glows -->
<div class="absolute top-16 left-1/2 -translate-x-1/2 w-[720px] h-[400px] bg-indigo-600/15 rounded-full blur-[140px] pointer-events-none"></div>
<div class="absolute top-52 right-10 w-[380px] h-[380px] bg-purple-600/10 rounded-full blur-[140px] pointer-events-none"></div>

<!-- 1. HERO SECTION -->
<section id="home" class="relative max-w-7xl mx-auto px-6 pt-16 pb-20 lg:pt-20 lg:pb-28">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
    
    <!-- Left Column: Copy & CTAs -->
    <div class="lg:col-span-6 space-y-6">
      
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-slate-100 dark:bg-white/[0.04] border border-slate-200 dark:border-white/[0.08] text-xs font-semibold text-slate-700 dark:text-slate-300">
        <span class="w-1.5 h-1.5 rounded-full bg-indigo-500 dark:bg-indigo-400"></span>
        Build &bull; Design &bull; Grow
      </div>

      <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-slate-900 dark:text-white leading-[1.1]">
        Modern Websites,<br />
        Stunning Designs,<br />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-purple-500 via-indigo-500 to-sky-500 dark:from-purple-400 dark:via-indigo-400 dark:to-sky-400">Powerful Software</span>.
      </h1>

      <p class="text-slate-600 dark:text-slate-400 text-sm sm:text-base leading-relaxed max-w-xl">
        We help businesses turn ideas into digital products. From beautiful websites and eye-catching designs to custom software solutions — we build what you need, so you can focus on what you do best.
      </p>

      <div class="flex flex-wrap items-center gap-4 pt-2">
        <a href="#contact" class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-bold tracking-wide transition shadow-lg shadow-indigo-600/30">
          Start a Project
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
        <a href="#portfolio" class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-slate-100 hover:bg-slate-200 dark:bg-white/[0.05] dark:hover:bg-white/[0.09] border border-slate-300 dark:border-white/[0.08] text-slate-800 dark:text-slate-200 text-xs font-bold tracking-wide transition">
          <svg class="w-3 h-3 fill-current text-slate-600 dark:text-slate-300" viewBox="0 0 24 24">
            <polygon points="5 3 19 12 5 21 5 3"/>
          </svg>
          Explore Our Work
        </a>
      </div>

      <!-- Badges -->
      <div class="flex flex-wrap items-center gap-6 pt-6 text-xs text-slate-600 dark:text-slate-400">
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-indigo-500 dark:text-indigo-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
          </svg>
          <span>Fast Delivery</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-indigo-500 dark:text-indigo-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            <path d="m9 12 2 2 4-4"/>
          </svg>
          <span>Clean Code</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-indigo-500 dark:text-indigo-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 18v-6a9 9 0 0 1 18 0v6"/>
            <path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"/>
          </svg>
          <span>Ongoing Support</span>
        </div>
      </div>
    </div>

   <!-- Right Column: Modern Digital Studio Showcase -->
    <div class="lg:col-span-6 relative flex justify-center items-center">
      
      <!-- Glowing Backdrop Aura -->
      <div class="absolute -inset-2 bg-gradient-to-r from-indigo-500/20 via-purple-500/20 to-sky-500/20 rounded-3xl blur-2xl opacity-60"></div>

      <!-- Main Window (Web & Software Platform) -->
      <div class="relative w-full max-w-lg rounded-2xl bg-[#090D16]/95 backdrop-blur-xl border border-slate-200 dark:border-white/10 shadow-2xl shadow-indigo-950/20 dark:shadow-indigo-950/80 overflow-hidden">
        
        <!-- Window Header / Browser Bar -->
        <div class="h-10 bg-[#0B0F19] px-4 flex items-center justify-between border-b border-white/[0.06]">
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-rose-500/80"></span>
            <span class="w-3 h-3 rounded-full bg-amber-500/80"></span>
            <span class="w-3 h-3 rounded-full bg-emerald-500/80"></span>
          </div>
          <div class="px-3 py-1 rounded-md bg-white/[0.03] border border-white/[0.05] text-[10px] text-slate-400 font-mono flex items-center gap-1.5">
            <svg class="w-2.5 h-2.5 text-indigo-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/></svg>
            velixoft.com/platform
          </div>
          <div class="w-8"></div>
        </div>

        <!-- Window Body: Dashboard & Application UI -->
        <div class="p-6 space-y-5">
          
          <!-- Top Metric Banner -->
          <div class="flex items-center justify-between p-4 rounded-xl bg-gradient-to-r from-indigo-950/40 via-purple-950/20 to-slate-900 border border-white/[0.06]">
            <div>
              <span class="text-[10px] font-semibold uppercase tracking-wider text-indigo-400">Production Deploy</span>
              <h4 class="text-lg font-bold text-white mt-0.5">High Performance Web & Apps</h4>
              <p class="text-xs text-slate-400 mt-1">99.98% Uptime &bull; Lighthouse Score 100</p>
            </div>
            <div class="w-10 h-10 rounded-xl bg-indigo-600/20 border border-indigo-500/30 flex items-center justify-center text-indigo-400 font-mono text-xs font-bold">
              A+
            </div>
          </div>

          <!-- Two-Column Service Showcase inside Dashboard -->
          <div class="grid grid-cols-2 gap-3">
            <!-- Mini Metric Card 1 -->
            <div class="p-3.5 rounded-xl bg-[#0C111E] border border-white/[0.05] space-y-2">
              <div class="flex items-center justify-between text-xs text-slate-400">
                <span class="font-medium">Page Speed</span>
                <span class="text-emerald-400 font-bold">0.4s</span>
              </div>
              <div class="w-full h-1.5 bg-slate-800 rounded-full overflow-hidden">
                <div class="w-[94%] h-full bg-gradient-to-r from-indigo-500 to-emerald-400 rounded-full"></div>
              </div>
              <span class="text-[10px] text-slate-500 block">Optimized Core Web Vitals</span>
            </div>

            <!-- Mini Metric Card 2 -->
            <div class="p-3.5 rounded-xl bg-[#0C111E] border border-white/[0.05] space-y-2">
              <div class="flex items-center justify-between text-xs text-slate-400">
                <span class="font-medium">Clean Code</span>
                <span class="text-indigo-400 font-bold">TS / ES6</span>
              </div>
              <div class="w-full h-1.5 bg-slate-800 rounded-full overflow-hidden">
                <div class="w-[88%] h-full bg-gradient-to-r from-purple-500 to-indigo-500 rounded-full"></div>
              </div>
              <span class="text-[10px] text-slate-500 block">Zero Technical Debt</span>
            </div>
          </div>

          <!-- Bottom Interactive Activity Bar -->
          <div class="p-3 rounded-xl bg-[#070A10] border border-white/[0.05] flex items-center justify-between text-xs">
            <div class="flex items-center gap-2.5">
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
              <span class="text-slate-300 font-medium text-xs">System Active</span>
            </div>
            <span class="text-[11px] font-mono text-slate-500">Fastify &bull; React &bull; Tailwind</span>
          </div>

        </div>
      </div>

      <!-- Floating Card 1 (Top Right): Graphic Design & Brand System -->
      <div class="absolute -top-5 -right-4 hidden sm:block p-3 rounded-xl bg-[#0E1424]/90 backdrop-blur-md border border-slate-200 dark:border-white/10 shadow-xl w-44">
        <div class="flex items-center justify-between pb-2 border-b border-white/[0.06]">
          <span class="text-[10px] font-bold text-slate-300 uppercase tracking-wider">Design System</span>
          <span class="w-1.5 h-1.5 rounded-full bg-pink-400"></span>
        </div>
        <div class="flex items-center gap-1.5 mt-2.5">
          <span class="w-5 h-5 rounded-md bg-indigo-600 shadow-sm"></span>
          <span class="w-5 h-5 rounded-md bg-purple-600 shadow-sm"></span>
          <span class="w-5 h-5 rounded-md bg-pink-500 shadow-sm"></span>
          <span class="w-5 h-5 rounded-md bg-sky-400 shadow-sm"></span>
        </div>
        <span class="text-[9px] font-mono text-slate-500 mt-2 block">Tokens &bull; Figma Specs</span>
      </div>

      <!-- Floating Card 2 (Bottom Left): Engineering Terminal -->
      <div class="absolute -bottom-6 -left-6 hidden sm:block p-3.5 rounded-xl bg-[#0A0E18]/95 backdrop-blur-md border border-slate-200 dark:border-white/10 shadow-2xl w-52 font-mono text-[10px]">
        <div class="flex items-center gap-1.5 pb-2 border-b border-white/[0.06] text-slate-400 text-[10px]">
          <svg class="w-3 h-3 text-indigo-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
          <span>deploy.config.ts</span>
        </div>
        <div class="pt-2 space-y-1 text-slate-400">
          <p><span class="text-purple-400">const</span> studio = <span class="text-emerald-400">"Velixoft"</span>;</p>
          <p><span class="text-indigo-400">await</span> build(&#123; target: <span class="text-sky-300">"prod"</span> &#125;);</p>
          <p class="text-emerald-400 pt-0.5 flex items-center gap-1">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 inline-block"></span>
            Compiled in 240ms
          </p>
        </div>
      </div>

    </div>
  </div>
</section>
