---
---

<!-- 4. OUR WORK (Recent Projects Portfolio) -->
<section id="portfolio" class="max-w-7xl mx-auto px-6 py-20 border-t border-slate-200 dark:border-white/[0.06] transition-colors duration-300">
  <div class="flex items-center justify-between mb-10">
    <div>
      <span class="text-xs uppercase font-semibold tracking-widest text-indigo-600 dark:text-indigo-400">Our Work</span>
      <h2 class="text-3xl font-extrabold text-slate-900 dark:text-white mt-1">Some of Our Recent Projects</h2>
    </div>
    <a href="#contact" class="hidden sm:inline-flex items-center gap-1.5 text-xs font-semibold text-indigo-600 dark:text-indigo-400 hover:text-indigo-500 dark:hover:text-indigo-300">
      View All Projects 
      <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
    </a>
  </div>

  <!-- 4-Project Grid -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
    
    <!-- Project 1: SaaS Management Dashboard -->
    <div class="group rounded-2xl bg-white dark:bg-[#0B0F19] border border-slate-200 dark:border-white/[0.08] hover:border-indigo-500/50 overflow-hidden transition duration-300 shadow-sm dark:shadow-none">
      <div class="h-44 bg-[#07090E] p-4 flex flex-col justify-between relative overflow-hidden">
        <div class="text-[10px] font-mono text-slate-400">Manage Your Business Smarter</div>
        <div class="space-y-1.5 mt-2">
          <div class="h-3 w-1/2 rounded bg-indigo-600/40"></div>
          <div class="h-8 w-full rounded bg-slate-800/60 border border-white/5"></div>
          <div class="grid grid-cols-3 gap-1">
            <div class="h-10 rounded bg-slate-800/40"></div>
            <div class="h-10 rounded bg-slate-800/40"></div>
            <div class="h-10 rounded bg-slate-800/40"></div>
          </div>
        </div>
      </div>
      <div class="p-4 border-t border-slate-100 dark:border-white/[0.06]">
        <h4 class="text-xs font-bold text-slate-900 dark:text-white">SaaS Cloud Dashboard</h4>
        <p class="text-[11px] text-slate-600 dark:text-slate-400 mt-0.5">Custom Software Platform</p>
      </div>
    </div>

    <!-- Project 2: Fresh Food / E-commerce App -->
    <div class="group rounded-2xl bg-white dark:bg-[#0B0F19] border border-slate-200 dark:border-white/[0.08] hover:border-amber-500/50 overflow-hidden transition duration-300 shadow-sm dark:shadow-none">
      <div class="h-44 bg-[#07090E] p-4 flex flex-col justify-between relative overflow-hidden">
        <div class="text-[10px] font-mono text-slate-400">Fresh Food &bull; Better Living</div>
        <div class="w-24 h-24 rounded-full bg-gradient-to-tr from-amber-500/30 to-orange-500/10 absolute right-2 bottom-2 blur-sm"></div>
        <div class="mt-4 space-y-1 z-10">
          <div class="w-16 h-3 rounded bg-amber-500/30"></div>
          <div class="w-28 h-2 rounded bg-slate-700"></div>
        </div>
      </div>
      <div class="p-4 border-t border-slate-100 dark:border-white/[0.06]">
        <h4 class="text-xs font-bold text-slate-900 dark:text-white">Gourmet Food Ordering</h4>
        <p class="text-[11px] text-slate-600 dark:text-slate-400 mt-0.5">Full Stack E-Commerce</p>
      </div>
    </div>

    <!-- Project 3: Mobile Health & Fitness App -->
    <div class="group rounded-2xl bg-white dark:bg-[#0B0F19] border border-slate-200 dark:border-white/[0.08] hover:border-purple-500/50 overflow-hidden transition duration-300 shadow-sm dark:shadow-none">
      <div class="h-44 bg-[#07090E] p-4 flex items-center justify-center gap-3 relative overflow-hidden">
        <div class="w-16 h-28 rounded-lg bg-slate-900 border border-white/10 p-1.5 space-y-1">
          <div class="w-6 h-1 rounded bg-indigo-500"></div>
          <div class="w-full h-10 rounded bg-indigo-950/40"></div>
        </div>
        <div class="w-16 h-28 rounded-lg bg-slate-900 border border-white/10 p-1.5 space-y-1 -mt-4">
          <div class="w-6 h-1 rounded bg-purple-500"></div>
          <div class="w-full h-10 rounded bg-purple-950/40"></div>
        </div>
      </div>
      <div class="p-4 border-t border-slate-100 dark:border-white/[0.06]">
        <h4 class="text-xs font-bold text-slate-900 dark:text-white">Pulse Mobile App</h4>
        <p class="text-[11px] text-slate-600 dark:text-slate-400 mt-0.5">Mobile UI/UX Design</p>
      </div>
    </div>

    <!-- Project 4: Brand Identity (Elevate) -->
    <div class="group rounded-2xl bg-white dark:bg-[#0B0F19] border border-slate-200 dark:border-white/[0.08] hover:border-indigo-500/50 overflow-hidden transition duration-300 shadow-sm dark:shadow-none">
      <div class="h-44 bg-[#07090E] flex flex-col items-center justify-center p-4">
        <div class="flex flex-col items-center gap-2">
          <div class="w-12 h-12 rounded-xl bg-gradient-to-tr from-purple-600 to-indigo-500 flex items-center justify-center shadow-lg">
            <svg class="w-6 h-6 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
          </div>
          <span class="text-xs font-extrabold tracking-widest text-white uppercase">ELEVATE</span>
        </div>
      </div>
      <div class="p-4 border-t border-slate-100 dark:border-white/[0.06]">
        <h4 class="text-xs font-bold text-slate-900 dark:text-white">Elevate Brand System</h4>
        <p class="text-[11px] text-slate-600 dark:text-slate-400 mt-0.5">Graphic Design & Identity</p>
      </div>
    </div>

  </div>
</section>
