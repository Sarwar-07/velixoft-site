---
---

<!-- 3. WHY CHOOSE US (Your Vision, Our Expertise) -->
<section id="about" class="max-w-7xl mx-auto px-6 py-20 border-t border-slate-200 dark:border-white/[0.06] transition-colors duration-300">
  <div>
    <span class="text-xs uppercase font-semibold tracking-widest text-indigo-600 dark:text-indigo-400">Why Choose Us</span>
    <h2 class="text-3xl font-extrabold text-slate-900 dark:text-white mt-1">Your Vision, Our Expertise</h2>
    <p class="text-slate-600 dark:text-slate-400 text-xs mt-2 max-w-xl">
      We combine creativity, technology and strategy to deliver high-quality digital solutions that help your business grow.
    </p>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center mt-12">
    
    <!-- 4 Features List -->
    <div class="lg:col-span-5 grid grid-cols-1 sm:grid-cols-2 gap-6">
      
      <div class="space-y-2">
        <div class="w-9 h-9 rounded-full bg-indigo-600/15 dark:bg-indigo-600/20 text-indigo-600 dark:text-indigo-400 flex items-center justify-center">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
            <circle cx="9" cy="7" r="4"/>
            <path d="M22 21v-2a4 4 0 0 0-3-3.87"/>
            <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
          </svg>
        </div>
        <h4 class="text-sm font-bold text-slate-900 dark:text-white">Experienced Team</h4>
        <p class="text-slate-600 dark:text-slate-400 text-xs leading-relaxed">Skilled professionals with real-world experience.</p>
      </div>

      <div class="space-y-2">
        <div class="w-9 h-9 rounded-full bg-emerald-600/15 dark:bg-emerald-600/20 text-emerald-600 dark:text-emerald-400 flex items-center justify-center">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="3"/>
            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/>
          </svg>
        </div>
        <h4 class="text-sm font-bold text-slate-900 dark:text-white">Custom Solutions</h4>
        <p class="text-slate-600 dark:text-slate-400 text-xs leading-relaxed">Tailored to your goals, not just templates.</p>
      </div>

      <div class="space-y-2">
        <div class="w-9 h-9 rounded-full bg-sky-600/15 dark:bg-sky-600/20 text-sky-600 dark:text-sky-400 flex items-center justify-center">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/>
            <polyline points="12 6 12 12 16 14"/>
          </svg>
        </div>
        <h4 class="text-sm font-bold text-slate-900 dark:text-white">On-Time Delivery</h4>
        <p class="text-slate-600 dark:text-slate-400 text-xs leading-relaxed">We respect your time and never miss deadlines.</p>
      </div>

      <div class="space-y-2">
        <div class="w-9 h-9 rounded-full bg-pink-600/15 dark:bg-pink-600/20 text-pink-600 dark:text-pink-400 flex items-center justify-center">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>
          </svg>
        </div>
        <h4 class="text-sm font-bold text-slate-900 dark:text-white">Long-Term Support</h4>
        <p class="text-slate-600 dark:text-slate-400 text-xs leading-relaxed">We're here even after launch.</p>
      </div>

    </div>

    <!-- Right Visual Feature Banner -->
    <div class="lg:col-span-7 relative rounded-2xl overflow-hidden border border-slate-200 dark:border-white/10 bg-[#0B0F19] p-8 min-h-[280px] flex items-center justify-between shadow-xl shadow-slate-900/5 dark:shadow-none">
      <div class="space-y-4 max-w-xs z-10">
        <img 
         src="/logo.png" 
         alt="Velixoft" 
         class="h-20 sm:h-22 w-auto object-contain mb-4" 
         />
        <p class="text-xs text-slate-400 leading-relaxed">
          Dedicated workstations, modern dev environments, and agile pipelines delivering production software.
        </p>
      </div>

      <!-- Handwritten Accent -->
      <div class="z-10 text-right">
        <div class="font-['Caveat',cursive] text-3xl sm:text-4xl text-transparent bg-clip-text bg-gradient-to-r from-indigo-300 via-purple-300 to-pink-300 -rotate-6">
          Ideas<br />
          — into —<br />
          Reality
        </div>
      </div>

      <div class="absolute -right-10 top-0 w-72 h-72 bg-indigo-600/20 rounded-full blur-3xl pointer-events-none"></div>
    </div>

  </div>
</section>
