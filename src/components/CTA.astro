<!-- 5. FULL-WIDTH CALL TO ACTION (Violet-to-Cyan Banner) -->
<section id="contact" class="max-w-7xl mx-auto px-6 py-12">
  <div class="rounded-3xl bg-gradient-to-r from-indigo-50 via-purple-50 to-sky-50 dark:from-purple-600 dark:via-indigo-600 dark:to-sky-500 border border-indigo-200/80 dark:border-transparent p-8 sm:p-12 flex flex-col sm:flex-row items-center justify-between gap-6 shadow-xl shadow-indigo-100/50 dark:shadow-2xl dark:shadow-indigo-600/30 transition-colors duration-300">
    
    <div class="flex items-center gap-5">
      <div class="w-14 h-14 rounded-2xl bg-indigo-600/10 dark:bg-white/10 backdrop-blur-md flex items-center justify-center shrink-0 border border-indigo-200/80 dark:border-white/20 text-indigo-600 dark:text-white">
        <svg class="w-6 h-6 -rotate-12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="22" y1="2" x2="11" y2="13"/>
          <polygon points="22 2 15 22 11 13 2 9 22 2"/>
        </svg>
      </div>
      <div>
        <h3 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white">Let's Build Something Great Together</h3>
        <p class="text-slate-600 dark:text-slate-200 text-xs sm:text-sm mt-1">Have a project in mind? Get in touch and let's turn your ideas into reality.</p>
      </div>
    </div>

    <a href="mailto:contact@velixoft.com" class="inline-flex items-center gap-2 px-6 py-3.5 rounded-full bg-indigo-600 hover:bg-indigo-700 text-white dark:bg-white dark:hover:bg-slate-100 dark:text-slate-950 font-bold text-xs tracking-wide transition shadow-lg shrink-0 cursor-pointer">
      Get Started
      <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
    </a>

  </div>
</section>
