---

<!-- 2. OUR SERVICES SECTION -->
<section id="services" class="max-w-7xl mx-auto px-6 py-20 border-t border-slate-200 dark:border-white/[0.06] transition-colors duration-300">
  <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4">
    <div>
      <span class="text-xs uppercase font-semibold tracking-widest text-indigo-600 dark:text-indigo-400">Our Services</span>
      <h2 class="text-3xl font-extrabold text-slate-900 dark:text-white mt-1">What We Do Best</h2>
    </div>
    <p class="text-xs text-slate-600 dark:text-slate-400 max-w-xs md:text-right">
      End-to-end digital solutions to help your business stand out and scale.
    </p>
  </div>

  <!-- 3 Services Grid -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    
    <!-- Card 1: Website Development -->
    <div class="group rounded-2xl bg-white dark:bg-[#0B0F19] border border-slate-200 dark:border-white/[0.08] hover:border-indigo-500/50 p-6 flex flex-col justify-between transition duration-300 shadow-sm dark:shadow-none">
      <div>
        <div class="flex items-center justify-between mb-6">
          <div class="w-10 h-10 rounded-xl bg-indigo-600/15 dark:bg-indigo-600/20 text-indigo-600 dark:text-indigo-400 flex items-center justify-center">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/>
              <line x1="2" y1="12" x2="22" y2="12"/>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
            </svg>
          </div>
          <div class="w-8 h-8 rounded-full bg-slate-100 dark:bg-white/[0.03] group-hover:bg-indigo-600 text-slate-600 dark:text-slate-400 group-hover:text-white flex items-center justify-center transition">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </div>
        </div>
        <h3 class="text-lg font-bold text-slate-900 dark:text-white">Website Development</h3>
        <p class="text-slate-600 dark:text-slate-400 text-xs mt-2 leading-relaxed">
          Modern, fast and SEO-friendly websites that turn visitors into customers.
        </p>
      </div>

      <div class="mt-8 rounded-xl bg-slate-50 dark:bg-[#06080E] border border-slate-200 dark:border-white/[0.06] p-3 space-y-2">
        <div class="flex items-center gap-1.5 pb-1 border-b border-slate-200 dark:border-white/5">
          <div class="w-1.5 h-1.5 rounded-full bg-slate-400 dark:bg-slate-600"></div>
          <div class="w-1.5 h-1.5 rounded-full bg-slate-400 dark:bg-slate-600"></div>
          <div class="w-1.5 h-1.5 rounded-full bg-slate-400 dark:bg-slate-600"></div>
        </div>
        <div class="grid grid-cols-3 gap-2">
          <div class="col-span-2 h-14 rounded-md bg-indigo-100/60 dark:bg-indigo-950/40 border border-indigo-200 dark:border-indigo-500/20 p-2">
            <div class="w-12 h-1.5 bg-indigo-500 dark:bg-indigo-400 rounded"></div>
            <div class="w-20 h-1 bg-slate-400 dark:bg-slate-600 rounded mt-1.5"></div>
          </div>
          <div class="col-span-1 h-14 rounded-md bg-slate-200/60 dark:bg-slate-800/40 border border-slate-200 dark:border-white/5"></div>
        </div>
      </div>

      <a href="#contact" class="inline-flex items-center gap-1.5 text-xs font-semibold text-indigo-600 dark:text-indigo-400 hover:text-indigo-500 dark:hover:text-indigo-300 mt-6">
        Learn More 
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>

    <!-- Card 2: Graphic Design -->
    <div class="group rounded-2xl bg-white dark:bg-[#0B0F19] border border-slate-200 dark:border-white/[0.08] hover:border-pink-500/50 p-6 flex flex-col justify-between transition duration-300 shadow-sm dark:shadow-none">
      <div>
        <div class="flex items-center justify-between mb-6">
          <div class="w-10 h-10 rounded-xl bg-pink-600/15 dark:bg-pink-600/20 text-pink-600 dark:text-pink-400 flex items-center justify-center">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m12 19 7-7 3 3-7 7-3-3z"/>
              <path d="m18 13-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"/>
              <path d="m2 2 7.586 7.586"/>
              <circle cx="11" cy="11" r="2"/>
            </svg>
          </div>
          <div class="w-8 h-8 rounded-full bg-slate-100 dark:bg-white/[0.03] group-hover:bg-pink-600 text-slate-600 dark:text-slate-400 group-hover:text-white flex items-center justify-center transition">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </div>
        </div>
        <h3 class="text-lg font-bold text-slate-900 dark:text-white">Graphic Design</h3>
        <p class="text-slate-600 dark:text-slate-400 text-xs mt-2 leading-relaxed">
          Creative visuals that bring your brand to life and make a lasting impression.
        </p>
      </div>

      <div class="mt-8 rounded-xl bg-slate-900 dark:bg-[#06080E] border border-slate-800 dark:border-white/[0.06] p-3 flex items-center gap-3 justify-center">
        <img src="/logo.png" alt="Brand Logo" class="h-10 w-auto object-contain" />
        <div class="flex flex-col gap-1.5">
          <span class="text-[9px] font-mono uppercase tracking-wider text-slate-400 dark:text-slate-500">BRAND SYSTEM</span>
          <div class="flex gap-1.5">
            <span class="w-3.5 h-3.5 rounded-full bg-indigo-500"></span>
            <span class="w-3.5 h-3.5 rounded-full bg-purple-500"></span>
            <span class="w-3.5 h-3.5 rounded-full bg-sky-400"></span>
          </div>
        </div>
      </div>

      <a href="#contact" class="inline-flex items-center gap-1.5 text-xs font-semibold text-pink-600 dark:text-pink-400 hover:text-pink-500 dark:hover:text-pink-300 mt-6">
        Learn More 
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>

    <!-- Card 3: Software Development -->
    <div class="group rounded-2xl bg-white dark:bg-[#0B0F19] border border-slate-200 dark:border-white/[0.08] hover:border-emerald-500/50 p-6 flex flex-col justify-between transition duration-300 shadow-sm dark:shadow-none">
      <div>
        <div class="flex items-center justify-between mb-6">
          <div class="w-10 h-10 rounded-xl bg-emerald-600/15 dark:bg-emerald-600/20 text-emerald-600 dark:text-emerald-400 flex items-center justify-center">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="16 18 22 12 16 6"/>
              <polyline points="8 6 2 12 8 18"/>
            </svg>
          </div>
          <div class="w-8 h-8 rounded-full bg-slate-100 dark:bg-white/[0.03] group-hover:bg-emerald-600 text-slate-600 dark:text-slate-400 group-hover:text-white flex items-center justify-center transition">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </div>
        </div>
        <h3 class="text-lg font-bold text-slate-900 dark:text-white">Software Development</h3>
        <p class="text-slate-600 dark:text-slate-400 text-xs mt-2 leading-relaxed">
          Custom software, web apps and systems built for your unique needs.
        </p>
      </div>

      <div class="mt-8 rounded-xl bg-slate-900 dark:bg-[#06080E] border border-slate-800 dark:border-white/[0.06] p-3 font-mono text-[9px] text-slate-400 space-y-1">
        <p class="text-emerald-400">// API Endpoint</p>
        <p><span class="text-purple-400">fastify</span>.get(<span class="text-amber-400">'/api'</span>, (req, reply) =&gt; &#123;</p>
        <p class="pl-2 text-slate-300">reply.send(&#123; <span class="text-sky-300">ok</span>: true &#125;);</p>
        <p>&#125;);</p>
      </div>

      <a href="#contact" class="inline-flex items-center gap-1.5 text-xs font-semibold text-emerald-600 dark:text-emerald-400 hover:text-emerald-500 dark:hover:text-emerald-300 mt-6">
        Learn More 
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>

  </div>
</section>
