---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="UI/UX & Graphic Design Services | Velixoft">
  <div class="max-w-5xl mx-auto px-6 py-12 lg:py-20">
    
    <!-- Breadcrumb / Back Link -->
    <a href="/#services" class="inline-flex items-center gap-2 text-xs font-semibold text-pink-600 dark:text-pink-400 hover:text-pink-500 dark:hover:text-pink-300 transition mb-8 group">
      <svg class="w-4 h-4 transition-transform group-hover:-translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M19 12H5M12 19l-7-7 7-7"/>
      </svg>
      Back to Home
    </a>

    <!-- Hero Header -->
    <div class="space-y-4">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-pink-50 dark:bg-white/[0.04] border border-pink-200/80 dark:border-white/[0.08] text-xs font-semibold text-pink-700 dark:text-pink-300">
        <span class="w-1.5 h-1.5 rounded-full bg-pink-500"></span>
        Brand Identity & UI/UX Design
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-slate-900 dark:text-white leading-[1.15]">
        Creative Visuals, Design Systems & High-Impact UI/UX
      </h1>
      <p class="text-slate-600 dark:text-slate-400 text-base sm:text-lg leading-relaxed max-w-3xl">
        A captivating digital product begins with unforgettable design. We combine user research, intuitive interface design, and systematic branding tokens that make your brand stand out.
      </p>
    </div>

    <!-- Core Offerings Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-12">
      
      <div class="p-6 rounded-2xl bg-white dark:bg-[#0B0F19] border border-slate-200 dark:border-white/[0.08] shadow-sm dark:shadow-none space-y-3">
        <div class="w-10 h-10 rounded-xl bg-pink-600/15 dark:bg-pink-600/20 text-pink-600 dark:text-pink-400 flex items-center justify-center">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="m12 19 7-7 3 3-7 7-3-3z"/>
            <path d="m18 13-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"/>
            <path d="m2 2 7.586 7.586"/>
            <circle cx="11" cy="11" r="2"/>
          </svg>
        </div>
        <h3 class="text-lg font-bold text-slate-900 dark:text-white">Brand Identity & Visual Logos</h3>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
          Comprehensive brand guidelines, modern logo marks, color harmony palettes, and typography rules crafted to resonate with your audience.
        </p>
      </div>

      <div class="p-6 rounded-2xl bg-white dark:bg-[#0B0F19] border border-slate-200 dark:border-white/[0.08] shadow-sm dark:shadow-none space-y-3">
        <div class="w-10 h-10 rounded-xl bg-purple-600/15 dark:bg-purple-600/20 text-purple-600 dark:text-purple-400 flex items-center justify-center">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/>
            <rect width="7" height="9" x="14" y="12" rx="1"/><rect width="7" height="5" x="3" y="16" rx="1"/>
          </svg>
        </div>
        <h3 class="text-lg font-bold text-slate-900 dark:text-white">Design Systems & Figma Specs</h3>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
          Component libraries, reusable tokens, auto-layout frameworks, and developer handoff documentation that supercharge engineering velocity.
        </p>
      </div>

      <div class="p-6 rounded-2xl bg-white dark:bg-[#0B0F19] border border-slate-200 dark:border-white/[0.08] shadow-sm dark:shadow-none space-y-3">
        <div class="w-10 h-10 rounded-xl bg-indigo-600/15 dark:bg-indigo-600/20 text-indigo-600 dark:text-indigo-400 flex items-center justify-center">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect width="14" height="20" x="5" y="2" rx="2" ry="2"/><path d="M12 18h.01"/>
          </svg>
        </div>
        <h3 class="text-lg font-bold text-slate-900 dark:text-white">Mobile & Web App UI/UX</h3>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
          Human-centered UX research, wireframing, high-fidelity prototypes, and user flows designed to eliminate friction and delight customers.
        </p>
      </div>

      <div class="p-6 rounded-2xl bg-white dark:bg-[#0B0F19] border border-slate-200 dark:border-white/[0.08] shadow-sm dark:shadow-none space-y-3">
        <div class="w-10 h-10 rounded-xl bg-amber-600/15 dark:bg-amber-600/20 text-amber-600 dark:text-amber-400 flex items-center justify-center">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/><path d="m4.93 4.93 4.24 4.24"/><path d="m14.83 9.17 4.24-4.24"/>
            <path d="m14.83 14.83 4.24 4.24"/><path d="m9.17 14.83-4.24 4.24"/>
          </svg>
        </div>
        <h3 class="text-lg font-bold text-slate-900 dark:text-white">Marketing Graphics & Digital Assets</h3>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
          Custom illustrations, social media media kits, pitch deck graphics, and marketing banners that amplify campaigns and attract qualified leads.
        </p>
      </div>

    </div>

    <!-- Design Tooling Highlights -->
    <div class="mt-12 p-8 rounded-2xl bg-slate-100 dark:bg-[#080B14] border border-slate-200 dark:border-white/[0.06] space-y-4">
      <span class="text-xs uppercase font-semibold tracking-wider text-pink-600 dark:text-pink-400">Our Tooling</span>
      <h3 class="text-xl font-bold text-slate-900 dark:text-white">Tools & Frameworks We Master</h3>
      <div class="flex flex-wrap gap-2.5 pt-2">
        {['Figma', 'FigJam', 'Adobe Illustrator', 'Adobe Photoshop', 'Tokens Studio', 'Tailwind Colors', 'Protopie', 'Spline 3D'].map((tool) => (
          <span class="px-3.5 py-1.5 rounded-xl bg-white dark:bg-white/[0.05] border border-slate-200 dark:border-white/10 text-xs font-semibold text-slate-800 dark:text-slate-200 shadow-sm dark:shadow-none">
            {tool}
          </span>
        ))}
      </div>
    </div>

    <!-- CTA Section -->
    <div class="mt-14 p-8 sm:p-10 rounded-3xl bg-gradient-to-r from-pink-600 via-purple-600 to-indigo-600 text-white flex flex-col sm:flex-row items-center justify-between gap-6 shadow-xl shadow-pink-600/25">
      <div>
        <h3 class="text-2xl font-bold">Ready to elevate your visual identity?</h3>
        <p class="text-white/80 text-xs sm:text-sm mt-1">Let's craft designs that leave an unforgettable impression.</p>
      </div>
      <a href="/#contact" class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-white text-slate-950 font-bold text-xs tracking-wide hover:bg-slate-100 transition shrink-0 shadow-md">
        Start Designing
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>

  </div>
</Layout>
