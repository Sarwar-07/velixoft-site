---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Web Development Services | Velixoft">
  <div class="max-w-5xl mx-auto px-6 py-12 lg:py-20">
    
    <!-- Breadcrumb / Back Link -->
    <a href="/#services" class="inline-flex items-center gap-2 text-xs font-semibold text-indigo-600 dark:text-indigo-400 hover:text-indigo-500 dark:hover:text-indigo-300 transition mb-8 group">
      <svg class="w-4 h-4 transition-transform group-hover:-translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M19 12H5M12 19l-7-7 7-7"/>
      </svg>
      Back to Home
    </a>

    <!-- Hero Header -->
    <div class="space-y-4">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-indigo-50 dark:bg-white/[0.04] border border-indigo-200/80 dark:border-white/[0.08] text-xs font-semibold text-indigo-700 dark:text-indigo-300">
        <span class="w-1.5 h-1.5 rounded-full bg-indigo-500"></span>
        Website Engineering & Design
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-slate-900 dark:text-white leading-[1.15]">
        Modern, High-Speed & SEO-Engineered Websites
      </h1>
      <p class="text-slate-600 dark:text-slate-400 text-base sm:text-lg leading-relaxed max-w-3xl">
        We craft tailored web experiences that combine award-winning aesthetics, lightning-fast Core Web Vitals, and conversion-focused architectures. Turn passive visitors into enthusiastic clients.
      </p>
    </div>

    <!-- Core Offerings Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-12">
      
      <div class="p-6 rounded-2xl bg-white dark:bg-[#0B0F19] border border-slate-200 dark:border-white/[0.08] shadow-sm dark:shadow-none space-y-3">
        <div class="w-10 h-10 rounded-xl bg-indigo-600/15 dark:bg-indigo-600/20 text-indigo-600 dark:text-indigo-400 flex items-center justify-center">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/>
          </svg>
        </div>
        <h3 class="text-lg font-bold text-slate-900 dark:text-white">Custom Business Platforms</h3>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
          Cleanly engineered websites for businesses, agencies, and institutions that convey trust, credibility, and brand power.
        </p>
      </div>

      <div class="p-6 rounded-2xl bg-white dark:bg-[#0B0F19] border border-slate-200 dark:border-white/[0.08] shadow-sm dark:shadow-none space-y-3">
        <div class="w-10 h-10 rounded-xl bg-emerald-600/15 dark:bg-emerald-600/20 text-emerald-600 dark:text-emerald-400 flex items-center justify-center">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/>
          </svg>
        </div>
        <h3 class="text-lg font-bold text-slate-900 dark:text-white">Performance & SEO-First Architecture</h3>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
          Zero-bloat HTML, server-side static rendering, instant route transitions, and 100/100 Lighthouse performance metrics.
        </p>
      </div>

      <div class="p-6 rounded-2xl bg-white dark:bg-[#0B0F19] border border-slate-200 dark:border-white/[0.08] shadow-sm dark:shadow-none space-y-3">
        <div class="w-10 h-10 rounded-xl bg-purple-600/15 dark:bg-purple-600/20 text-purple-600 dark:text-purple-400 flex items-center justify-center">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/>
            <path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/>
          </svg>
        </div>
        <h3 class="text-lg font-bold text-slate-900 dark:text-white">E-Commerce & Digital Storefronts</h3>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
          Seamless checkout flows, inventory synchronization, secure payment gateway integrations, and mobile-optimized carts.
        </p>
      </div>

      <div class="p-6 rounded-2xl bg-white dark:bg-[#0B0F19] border border-slate-200 dark:border-white/[0.08] shadow-sm dark:shadow-none space-y-3">
        <div class="w-10 h-10 rounded-xl bg-sky-600/15 dark:bg-sky-600/20 text-sky-600 dark:text-sky-400 flex items-center justify-center">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          </svg>
        </div>
        <h3 class="text-lg font-bold text-slate-900 dark:text-white">CMS & Content Management</h3>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
          Empower your team to edit, publish, and scale blog posts and marketing landing pages effortlessly with Headless CMS solutions.
        </p>
      </div>

    </div>

    <!-- Tech Stack Highlights -->
    <div class="mt-12 p-8 rounded-2xl bg-slate-100 dark:bg-[#080B14] border border-slate-200 dark:border-white/[0.06] space-y-4">
      <span class="text-xs uppercase font-semibold tracking-wider text-indigo-600 dark:text-indigo-400">Our Stack</span>
      <h3 class="text-xl font-bold text-slate-900 dark:text-white">Technologies We Leverage</h3>
      <div class="flex flex-wrap gap-2.5 pt-2">
        {['Astro', 'React', 'Next.js', 'TypeScript', 'Tailwind CSS', 'Vite', 'Cloudflare Pages', 'Vercel', 'Node.js', 'PostgreSQL'].map((tech) => (
          <span class="px-3.5 py-1.5 rounded-xl bg-white dark:bg-white/[0.05] border border-slate-200 dark:border-white/10 text-xs font-semibold text-slate-800 dark:text-slate-200 shadow-sm dark:shadow-none">
            {tech}
          </span>
        ))}
      </div>
    </div>

    <!-- CTA Section -->
    <div class="mt-14 p-8 sm:p-10 rounded-3xl bg-gradient-to-r from-indigo-600 to-indigo-500 text-white flex flex-col sm:flex-row items-center justify-between gap-6 shadow-xl shadow-indigo-600/25">
      <div>
        <h3 class="text-2xl font-bold">Have a website in mind?</h3>
        <p class="text-white/80 text-xs sm:text-sm mt-1">Let's discuss your design, requirements, and build schedule.</p>
      </div>
      <a href="/#contact" class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-white text-slate-950 font-bold text-xs tracking-wide hover:bg-slate-100 transition shrink-0 shadow-md">
        Start Your Project
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>

  </div>
</Layout>
